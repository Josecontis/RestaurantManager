# Copy this file to .env and fill in the values. Never commit .env.

# Neon connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Sites allowed to call the server, comma separated
ALLOWED_ORIGINS=http://localhost:3000

PORT=4000

# Proxies between the internet and the server, used to know the visitor's address
# for the admin login lock: 0 on the PC, on Render see doc/piano-server-database.md
TRUST_PROXY_HOPS=0
